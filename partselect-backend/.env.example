# PartSelect backend configuration — copy to .env and fill in your API key.
#
# The LLM client speaks the OpenAI chat-completions format, so the DEEPSEEK_*
# variables accept any OpenAI-compatible endpoint (OpenAI, DeepSeek, etc.).
# Set the base URL and model to match the provider whose key you use.

DEEPSEEK_API_KEY=your-api-key-here
DEEPSEEK_BASE_URL=https://api.openai.com/v1
DEEPSEEK_MODEL=gpt-4o-mini

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/partselect
REDIS_URL=redis://localhost:6379/0
CHROMA_HOST=localhost
CHROMA_PORT=8001
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
